{
    "framework": "vite",
    "outputDirectory": "dist",
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
        {
            "source": "/tr",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/tr/",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/tr/galata-rum-okulu",
            "destination": "/tarihce",
            "permanent": true
        },
        {
            "source": "/tr/galata-rum-okulu/",
            "destination": "/tarihce",
            "permanent": true
        },
        {
            "source": "/tr/sergiler",
            "destination": "/gecmis-etkinlikler",
            "permanent": true
        },
        {
            "source": "/tr/sergiler/",
            "destination": "/gecmis-etkinlikler",
            "permanent": true
        },
        {
            "source": "/tr/etkinlikler",
            "destination": "/gecmis-etkinlikler",
            "permanent": true
        },
        {
            "source": "/tr/etkinlikler/",
            "destination": "/gecmis-etkinlikler",
            "permanent": true
        },
        {
            "source": "/tr/duyurular",
            "destination": "/gecmis-etkinlikler",
            "permanent": true
        },
        {
            "source": "/tr/duyurular/",
            "destination": "/gecmis-etkinlikler",
            "permanent": true
        },
        {
            "source": "/tr/iletisim",
            "destination": "/bize-ulasin",
            "permanent": true
        },
        {
            "source": "/tr/iletisim/",
            "destination": "/bize-ulasin",
            "permanent": true
        },
        {
            "source": "/tr/:path+",
            "destination": "/:path+",
            "permanent": true
        },
        {
            "source": "/en/galata-greek-school",
            "destination": "/en/tarihce",
            "permanent": true
        },
        {
            "source": "/en/galata-greek-school/",
            "destination": "/en/tarihce",
            "permanent": true
        },
        {
            "source": "/en/exhibitions",
            "destination": "/en/gecmis-etkinlikler",
            "permanent": true
        },
        {
            "source": "/en/exhibitions/",
            "destination": "/en/gecmis-etkinlikler",
            "permanent": true
        },
        {
            "source": "/en/events",
            "destination": "/en/gecmis-etkinlikler",
            "permanent": true
        },
        {
            "source": "/en/events/",
            "destination": "/en/gecmis-etkinlikler",
            "permanent": true
        },
        {
            "source": "/en/announcements",
            "destination": "/en/gecmis-etkinlikler",
            "permanent": true
        },
        {
            "source": "/en/announcements/",
            "destination": "/en/gecmis-etkinlikler",
            "permanent": true
        },
        {
            "source": "/en/contact",
            "destination": "/en/bize-ulasin",
            "permanent": true
        },
        {
            "source": "/en/contact/",
            "destination": "/en/bize-ulasin",
            "permanent": true
        },
        {
            "source": "/el/galata-greek-school",
            "destination": "/el/tarihce",
            "permanent": true
        },
        {
            "source": "/el/galata-greek-school/",
            "destination": "/el/tarihce",
            "permanent": true
        },
        {
            "source": "/el/exhibitions",
            "destination": "/el/gecmis-etkinlikler",
            "permanent": true
        },
        {
            "source": "/el/exhibitions/",
            "destination": "/el/gecmis-etkinlikler",
            "permanent": true
        },
        {
            "source": "/el/events",
            "destination": "/el/gecmis-etkinlikler",
            "permanent": true
        },
        {
            "source": "/el/events/",
            "destination": "/el/gecmis-etkinlikler",
            "permanent": true
        },
        {
            "source": "/el/announcements",
            "destination": "/el/gecmis-etkinlikler",
            "permanent": true
        },
        {
            "source": "/el/announcements/",
            "destination": "/el/gecmis-etkinlikler",
            "permanent": true
        },
        {
            "source": "/el/contact",
            "destination": "/el/bize-ulasin",
            "permanent": true
        },
        {
            "source": "/el/contact/",
            "destination": "/el/bize-ulasin",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/admin",
            "destination": "/app.html"
        },
        {
            "source": "/admin/:path*",
            "destination": "/app.html"
        },
        {
            "source": "/en/admin",
            "destination": "/app.html"
        },
        {
            "source": "/en/admin/:path*",
            "destination": "/app.html"
        },
        {
            "source": "/el/admin",
            "destination": "/app.html"
        },
        {
            "source": "/el/admin/:path*",
            "destination": "/app.html"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "host",
                    "value": ".*\\.vercel\\.app"
                }
            ],
            "headers": [
                {
                    "key": "X-Robots-Tag",
                    "value": "noindex, nofollow"
                }
            ]
        },
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https://*.supabase.co https://tvloakrlqazcadokliaf.supabase.co https://galatarumokulu.org https: data: blob:; connect-src 'self' https://*.supabase.co; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com; frame-ancestors 'none'"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=31536000; includeSubDomains; preload"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(), microphone=(), geolocation=()"
                }
            ]
        },
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/images/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=86400, stale-while-revalidate=604800"
                }
            ]
        },
        {
            "source": "/(.*).html",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ]
        }
    ]
}
